{
  "cli": {
    "version": ">= 24.4.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.15.0",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" },
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "2APB3NHX44",
        "sku": "lighthouse-guard"
      }
    }
  }
}
